rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /routes/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /cyclingSegments/{segmentId} {
      allow read: if true;
      allow write: if false;
    }

    match /ratings/{ratingId} {
      allow read: if true;

      allow create: if request.auth != null
        && ratingId == request.resource.data.segmentId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['segmentId', 'userId', 'score', 'updatedAt'])
        && request.resource.data.segmentId is string
        && request.resource.data.segmentId.size() >= 1
        && request.resource.data.segmentId.size() <= 100
        && !request.resource.data.segmentId.matches('.*\\/.*')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && resource.data.segmentId == request.resource.data.segmentId
        && resource.data.userId == request.auth.uid
        && ratingId == request.resource.data.segmentId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['segmentId', 'userId', 'score', 'updatedAt'])
        && request.resource.data.segmentId is string
        && request.resource.data.segmentId.size() >= 1
        && request.resource.data.segmentId.size() <= 100
        && !request.resource.data.segmentId.matches('.*\\/.*')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user';
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    match /eventRegistrations/{registrationId} {
      // Registrations contain contact details and are managed only by authenticated Cloud Functions.
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
